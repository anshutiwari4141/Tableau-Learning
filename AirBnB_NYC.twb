      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_0938483067658241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]* [Review Scores Rating]' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_0938483068203010]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 THEN &quot;LUXURY&quot;&#13;&#10;&#13;&#10;ELSEIF [Price]&gt;=150 THEN &quot; STANDARD&quot;&#13;&#10;&#13;&#10;ELSE &quot;BUDGET&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_0938483070218243]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;=100 THEN &quot;HIGHLY REVIEWED&quot;&#13;&#10;ELSE &quot; LESS REVIEWED&quot;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_0938483070656516]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;= TODAY()THEN &quot; Active Host&quot;&#13;&#10;ELSE &quot; New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category ' datatype='string' name='[Calculation_1005003858903042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt; [Parameters].[Parameter 1005003857891329]&#13;&#10;THEN &quot; Above Limit &quot;&#13;&#10;ELSE &quot; Below Limit &quot;&#13;&#10;END' />
      </column>
      <column caption='Beds Criteria ' datatype='string' name='[Calculation_1005003861860357]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Beds]&gt; [Parameters].[Parameter 1005003861467140]&#13;&#10;THEN &quot;Optimum number of beds&quot;&#13;&#10;ELSE&quot; Not Enough Beds&quot;&#13;&#10;END' />
      </column>
      <column caption='Hotel Count ' datatype='integer' name='[Calculation_1005003865182215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&quot;Name&quot;)' />
      </column>
      <column caption='Host Since_NEW' datatype='date' name='[Calculation_1005003866800136]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Property Type_NEW' datatype='string' name='[Calculation_1005003868659721]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Property Type],&quot;Unknown&quot;)' />
      </column>
